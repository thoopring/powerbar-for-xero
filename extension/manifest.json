{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "host_permissions": ["https://*.xero.com/*"],
  "permissions": ["storage"],
  "optional_permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.xero.com/*"],
      "js": [
        "src/core/namespace.js",
        "src/core/selectors.js",
        "src/core/settings.js",
        "src/core/dom.js",
        "src/core/menu.js",
        "src/core/license.js",
        "src/modules/statements-menu.js",
        "src/modules/purchases-submenu.js",
        "src/modules/sales-submenu.js",
        "src/modules/popup-dismiss.js",
        "src/modules/favorites-bar.js",
        "src/modules/settings-shortcuts.js",
        "src/modules/reconcile-menu.js",
        "src/modules/invoice-filename.js",
        "src/main.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
